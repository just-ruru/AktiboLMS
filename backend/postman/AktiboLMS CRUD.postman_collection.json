  "item": [
    {
      "name": "Instructor - Create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('runId', Date.now().toString());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created (201)', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('instructorId', data.id);",
              "pm.collectionVariables.set('instructorCode', data.instructorId);",
              "pm.collectionVariables.set('instructorEmail', data.email);",
              "pm.test('Response excludes password', function () { pm.expect(data).not.to.have.property('password'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instructorId\": \"I-{{runId}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Instructor\",\n  \"email\": \"instructor-{{runId}}@example.test\",\n  \"password\": \"TestPassword123\",\n  \"description\": \"Created by the Postman CRUD collection\"\n}"
        },
        "url": "{{baseUrl}}/api/instructors"
      }
    },
    {
      "name": "Instructor - Read by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OK (200)', function () { pm.response.to.have.status(200); });",
              "pm.test('Returned the created instructor', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('instructorId'))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/instructors/{{instructorId}}"
      }
    },
    {
      "name": "Instructor - List (paginated)",
