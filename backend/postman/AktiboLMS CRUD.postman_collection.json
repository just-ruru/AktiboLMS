          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OK (200)', function () { pm.response.to.have.status(200); });",
              "pm.test('Page response contains created instructor', function () { pm.expect(pm.response.json().content.some(function (item) { return item.id === Number(pm.collectionVariables.get('instructorId')); })).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/instructors?page=0&size=20"
      }
    },
